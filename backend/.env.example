# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"
# For Postgres in production, use something like:
# DATABASE_URL="postgresql://user:password@host:5432/healthcare_db"

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Email (choose one provider) ----
# Nodemailer generic SMTP (works with Mailgun, SendGrid SMTP relay, Gmail, etc.)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM="Clinic Appointments <no-reply@your-clinic.com>"

# ---- Google Calendar OAuth 2.0 ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ---- Slot hold mechanism ----
SLOT_HOLD_MINUTES=5
